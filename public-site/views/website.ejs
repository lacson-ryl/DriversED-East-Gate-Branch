<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-auto overflow-y-auto">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>DriversEd Driving School</title>
  <link rel="preload" href="/public/f-css/output.css" as="style">
  <link rel="stylesheet" href="/public/f-css/output.css">

  <!-- Swiper CSS -->
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
  <style>
    button#previous-promote img {
      filter: drop-shadow(0 0 0.15rem #facc15);
      /* yellow-500 */
    }

    .swiper-container {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      overflow: hidden;
    }

    .swiper-wrapper {
      display: flex;
      align-items: center;
    }

    .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card {
      width: 200px;
      height: 400px;
      transition: transform 0.3s ease;
    }

    .swiper-pagination-bullet {
      background-color: #cbd5e1;
    }

    .swiper-pagination-bullet-active {
      background-color: #fbbf24;
      opacity: 1;
    }

    .swiper-button-next,
    .swiper-button-prev {
      color: #fbbf24;
      width: 40px;
      height: 40px;
      top: auto;
      bottom: -50px;
      background-color: rgba(0, 0, 0, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .swiper-button-next:hover,
    .swiper-button-prev:hover {
      background-color: rgba(0, 0, 0, 0.1);
    }

    .swiper-button-next::after,
    .swiper-button-prev::after {
      font-size: 20px;
    }

    #image-background {
      will-change: opacity;
    }

    #promote-container {
      will-change: transform, opacity;
    }

    #tag-line {
      min-height: 2.5rem;
    }

    #tag-paragraph {
      min-height: 5rem;
    }

    /* Smooth scrollbar for branch list */
    #branch-list::-webkit-scrollbar {
      width: 6px;
    }

    #branch-list::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    #branch-list::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }

    #branch-list::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Shrink buttons on screens smaller than 768px */
    @media (max-width: 767px) {
      .swiper-container {
        width: 100%;
        max-width: 100%;
      }

      .swiper-button-next,
      .swiper-button-prev {
        width: 32px;
        height: 32px;
      }
    }
  </style>
  <script src="https://unpkg.com/swiper/swiper-bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>

<body class="bg-slate-50 text-slate-900 w-full antialiased">
  <div>
    <!-- TopBar -->
    <header id="navbar"
      class="fixed top-0 left-0 w-full bg-neutral-900 bg-opacity-0 transition-all duration-300 z-50 h-32 md:px-24">
      <div class="w-full px-4 py-4 flex items-center text-white content-center h-full justify-between">
        <!-- Logo and title -->
        <div class="flex items-center min-w-52 gap-4 h-full">
          <img src="/public/f-assets/solid/drivers_ed_logo-no-bg.png" alt="DriversEd logo"
            class="h-10 w-auto min-w-24" />
          <div>
            <h1 class="text-base md:text-lg font-semibold">Driver's Ed Driving School</h1>
            <div class="text-xs md:text-sm text-slate-200">Safe. Confident. Licensed.</div>
          </div>
        </div>

        <!-- Hamburger button (visible on small screens) -->
        <button id="nav-toggle" class="md:hidden p-2 z-20">
          <svg class="w-7 h-7 lg:hidden" fill="white" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Navigation links -->
        <nav id="nav-menu"
          class="flex flex-col min-w-96 md:flex md:flex-row items-center md:items-center gap-4 text-sm absolute md:static top-24 left-0 w-full md:w-auto bg-neutral-900 md:bg-transparent px-4 py-4 md:p-0 z-40">
          <a href="#automate-slider-section" class="hover:underline nav-link">Home</a>
          <a href="#services-section" class="hover:underline nav-link">Courses</a>
          <a href="#instructor-section" class="hover:underline nav-link">Instructors</a>
          <a href="#branch-section" class="hover:underline nav-link">Locations</a>
          <a href="/public/contact-us" class="hover:underline">Contact Us</a>
          <a href="/account/user-login" class="px-3 py-2 bg-amber-300 hover:bg-amber-500 rounded-md text-white">My
            Account</a>
        </nav>

      </div>
    </header>
  </div>

  <section id="automate-slider-section"
    class="min-h-[calc(100vh+1px)] bg-black w-full grid lg:grid-cols-1 gap-10 items-center">
    <div id="promotional-output"
      class="relative flex flex-col bg-black w-full h-full items-center content-center overflow-hidden animate-fadeIn-public">
      <!-- Background image layer -->
      <img id="image-background" src="" alt="" class="absolute inset-0 w-full h-full object-cover -z-0" />
      <div class="absolute inset-0 w-full h-full object-cover z-0 bg-black opacity-50"></div>
      <!-- Foreground content -->
      <div id="promote-container" class="absolute w-full h-full">
        <div class="mt-28 w-full text-center text-white content-center z-10 py-10 px-24 ">
          <h2 id="tag-line" class="text-3xl font-extrabold leading-tight min-h-9 mb-4">
          </h2>
          <p id="tag-paragraph" class="text-slate-100 mb-6 max-w-[500px] min-h-12 mx-auto">
            loading...
          </p>
          <div class="flex justify-center gap-3 place-self-center">
            <a id="learn-more-href" href="/public/courses"
              class="inline-block text-sm md:text-base px-5 py-3 bg-amber-400 text-white rounded-md shadow">
              Learn More
            </a>
            <a href="/public/contact"
              class="inline-block text-sm md:text-base px-5 py-3 border border-slate-100 rounded-md text-slate-100">
              Contact Us
            </a>
          </div>
        </div>
        <div id="action-buttons"
          class="z-10 content-center text-center absolute bottom-10 left-1/2 transform -translate-x-1/2 flex items-center gap-4">
          <button id="previous-promote" class="-rotate-90 ">
            <div
              class="w-0 h-0 border-l-[12px] border-r-[12px] border-b-[20px] border-transparent border-b-red-700 hover:border-b-rose-500">
            </div>
          </button>
          <div id="circles-indicators" class="flex gap-2">
            <!-- indicators go here -->
          </div>
          <button id="next-promote" class="rotate-90">
            <div
              class="w-0 h-0 border-l-[12px] border-r-[12px] border-b-[20px] border-transparent border-b-green-700 hover:border-b-green-400">
            </div>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services-section" class="w-full py-16 md:py-24 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div class="inline-block mb-4">
          <span class="text-amber-500 font-semibold text-sm uppercase tracking-wide">Our Courses</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
          Professional Driving Courses
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Choose from our expertly designed programs tailored for every skill level
        </p>
      </div>

      <!-- Services Carousel -->
      <div class="swiper-container swiper1" space-between="10">
        <div class="swiper-wrapper">
          <!-- Slides will be dynamically inserted here -->
        </div>
        <!-- Add Pagination -->
        <div class="swiper-pagination swiper-pagination1"></div>
        <!-- Add Navigation -->
        <div class="swiper-button-next swiper-button-next1"></div>
        <div class="swiper-button-prev swiper-button-prev1"></div>
      </div>
    </div>
  </section>

  <!-- Instructors Section -->
  <section id="instructor-section" class="w-full py-16 md:py-24 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div class="inline-block mb-4">
          <span class="text-amber-400 font-semibold text-sm uppercase tracking-wide">Expert Team</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          Meet Our Professional Instructors
        </h2>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Certified professionals dedicated to making you a confident, safe driver
        </p>
      </div>

      <!-- Instructors Carousel -->
      <div class="swiper-container swiper2" space-between="10">
        <div class="swiper-wrapper">
          <!-- Slides will be dynamically inserted here -->
        </div>
        <!-- Add Pagination -->
        <div class="swiper-pagination swiper-pagination2"></div>
        <!-- Add Navigation -->
        <div class="swiper-button-next swiper-button-next2"></div>
        <div class="swiper-button-prev swiper-button-prev2"></div>
      </div>
    </div>
  </section>

  <!-- Locations Section -->
  <section id="branch-section" class="w-full py-16 md:py-24 bg-gradient-to-b from-white to-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div class="inline-block mb-4">
          <span class="text-amber-500 font-semibold text-sm uppercase tracking-wide">Visit Us</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
          Find Us at Our Locations
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Conveniently located across multiple areas for your accessibility
        </p>
      </div>

      <!-- Locations Layout -->
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Branch List -->
        <div class="md:col-span-1">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-bold text-slate-900 mb-4">Our Branches</h3>
            <ul id="branch-list" class="w-full flex flex-col gap-2">
              <!-- Branches will be dynamically inserted here -->
            </ul>
          </div>
        </div>

        <!-- Map -->
        <div class="md:col-span-2">
          <div class="bg-white rounded-lg shadow-md overflow-hidden h-96 md:h-full min-h-[400px]">
            <iframe id="mapFrame" src="" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-950 text-slate-300 px-18">
    <!-- Main Footer Content -->
    <div class="flex flex-col max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16 text-center">
      <div class="grid md:grid-cols-4 gap-8">
        <!-- About Section -->
        <div class="">
          <div class="flex items-center justify-center gap-3 mb-4">
            <img src="/public/f-assets/solid/drivers_ed_logo-no-bg.png" alt="DriversEd logo" class="h-8 w-auto" />
            <div>
              <h3 class="text-white font-bold text-sm">Driver's Ed</h3>
              <p class="text-xs text-slate-400">Driving School</p>
            </div>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            We offer complete driving courses at affordable rates. Our skilled instructors deliver
            competent, confident, and safe drivers.
          </p>
          <div class="flex justify-center gap-4 mt-4">
            <a href="https://www.facebook.com/DriversEdDrivingSchool"
              class="text-slate-400 hover:text-amber-400 transition">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333H16V2.169C15.547 2.118 14.303 2 12.479 2 9.412 2 7 3.655 7 6.699V8z" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="text-white font-semibold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#automate-slider-section" class="hover:text-amber-400 transition">Home</a></li>
            <li><a href="#services-section" class="hover:text-amber-400 transition">Courses</a></li>
            <li><a href="#instructor-section" class="hover:text-amber-400 transition">Instructors</a></li>
            <li><a href="#branch-section" class="hover:text-amber-400 transition">Locations</a></li>
            <li><a href="/public/contact-us" class="hover:text-amber-400 transition">Contact Us</a></li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div>
          <h4 class="text-white font-semibold mb-4">Get In Touch</h4>
          <ul class="space-y-3 text-sm">
            <li>
              <p class="text-slate-400">Phone</p>
              <p class="text-white font-medium">0917 326 4818</p>
            </li>
            <li>
              <p class="text-slate-400">Email</p>
              <p class="text-white font-medium">DriversEd1979@gmail.com</p>
            </li>
            <li>
              <p class="text-slate-400">Hours</p>
              <p class="text-white font-medium">Mon - Sat, 8:00 - 18:00</p>
            </li>
          </ul>
        </div>

        <!-- Enrollment Steps -->
        <div>
          <h4 class="text-white font-semibold mb-4">Enroll Now</h4>
          <ol class="text-sm space-y-2 list-decimal list-inside">
            <li class="text-slate-400">Create Account</li>
            <li class="text-slate-400">Choose Course</li>
            <li class="text-slate-400">Pay Fee</li>
            <li class="text-slate-400">Start Class</li>
          </ol>
          <a href="/account/user-login"
            class="inline-block mt-4 px-4 py-2 bg-amber-400 hover:bg-amber-500 text-white rounded-md font-medium transition">
            Enroll Now
          </a>
        </div>
      </div>

      <!-- Divider -->
      <div
        class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-slate-400">
        <p>© <span id="year"></span> Driver's Ed Driving School. All rights reserved.</p>
        <div class="flex gap-6 mt-4 md:mt-0">
          <a href="#" class="hover:text-amber-400 transition">Privacy Policy</a>
          <a href="#" class="hover:text-amber-400 transition">Terms & Conditions</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Client JS (kept inline per request; move to external file if desired) -->
  <script src="/public/f-jsfiles/new-website.js">
    window.addEventListener("load", () => {
      setTimeout(() => {
        window.scrollTo(0, 0);
      }, 0);
    });
  </script>
</body>

</html>
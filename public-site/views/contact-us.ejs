<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Contact Us - Driver's Ed Driving School</title>
    <meta name="description" content="Contact Driver's Ed Driving School for inquiries and enrollment information">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preload" href="/public/f-css/output.css" as="style">
    <link rel="stylesheet" href="/public/f-css/output.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>



</head>

<body class="bg-slate-50 text-slate-900 w-full antialiased">

    <!-- TopBar -->
    <header id="navbar" class="fixed top-0 left-0 w-full bg-neutral-900 transition-all duration-300 z-50 h-20 md:px-24">
        <div class="w-full px-4 py-4 flex items-center text-white content-center h-full justify-between">
            <!-- Logo and title -->
            <div class="flex items-center min-w-52 gap-4 h-full">
                <img src="/public/f-assets/solid/drivers_ed_logo-no-bg.png" alt="DriversEd logo"
                    class="h-10 w-auto min-w-24" />
                <div>
                    <h1 class="text-base md:text-lg font-semibold">Driver's Ed Driving School</h1>
                    <div class="text-xs md:text-sm text-slate-200">Safe. Confident. Licensed.</div>
                </div>
            </div>

            <!-- Hamburger button (visible on small screens) -->
            <button id="nav-toggle" class="md:hidden p-2 z-20">
                <svg class="w-7 h-7 lg:hidden" fill="white" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <!-- Navigation links -->
            <nav id="nav-menu"
                class="flex flex-col min-w-96 md:flex md:flex-row items-center md:items-center gap-4 text-sm absolute md:static top-20 left-0 w-full md:w-auto bg-neutral-900 md:bg-transparent px-4 py-4 md:p-0 z-40">
                <a href="/public/" class="hover:underline nav-link">Home</a>
                <a href="/public/" class="hover:underline nav-link">Courses</a>
                <a href="/public/" class="hover:underline nav-link">Instructors</a>
                <a href="/public/" class="hover:underline nav-link">Locations</a>
                <a href="/public/contact-us" class="hover:underline nav-link">Contact Us</a>
                <a href="/account/user-login" class="px-3 py-2 bg-amber-300 hover:bg-amber-500 rounded-md text-white">My
                    Account</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="pt-24 pb-12 md:pt-32 md:pb-16 px-4 md:px-24 bg-gradient-to-br from-slate-900 to-slate-800">
        <div class="max-w-3xl mx-auto text-center text-white">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Get in Touch</h1>
            <p class="text-lg text-slate-300">Have questions? We'd love to hear from you. Our team is ready to help you
                begin your driving journey.</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="py-12 md:py-16 px-4 md:px-24">
        <div class="max-w-5xl mx-auto">
            <div class="grid md:grid-cols-2 gap-12">

                <!-- Contact Info -->
                <div class="space-y-8">
                    <div>
                        <h3 class="text-2xl font-bold text-slate-900 mb-6">Contact Information</h3>
                        <p class="text-slate-600 mb-8">Reach out to us through any of these channels. We typically
                            respond within 24 hours.</p>
                    </div>

                    <div class="space-y-6">
                        <!-- Phone -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-md bg-amber-400 text-white">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Phone</h4>
                                <p class="text-slate-600">0917 326 4818</p>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-md bg-amber-400 text-white">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Email</h4>
                                <p class="text-slate-600">DriversEd1979@gmail.com</p>
                            </div>
                        </div>

                        <!-- Hours -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-md bg-amber-400 text-white">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Business Hours</h4>
                                <p class="text-slate-600">Monday - Saturday, 8:00 AM - 6:00 PM</p>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <div
                                    class="flex items-center justify-center h-12 w-12 rounded-md bg-amber-400 text-white">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Follow Us</h4>
                                <a href="https://www.facebook.com/DriversEdDrivingSchool"
                                    class="text-amber-500 hover:text-amber-600 font-medium">Facebook</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="bg-white rounded-lg shadow-lg p-8 border border-slate-200">
                    <h3 class="text-2xl font-bold text-slate-900 mb-6">Send us a Message</h3>
                    <form id="contact-form" class="space-y-5">
                        <div>
                            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Full Name</label>
                            <input type="text" id="name" name="name" required
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent outline-none transition"
                                placeholder="John Doe">
                        </div>

                        <div>
                            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email
                                Address</label>
                            <input type="email" id="email" name="email" required
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent outline-none transition"
                                placeholder="john@example.com">
                        </div>

                        <div>
                            <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Phone
                                Number</label>
                            <input type="tel" id="phone" name="phone"
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent outline-none transition"
                                placeholder="09XX XXX XXXX">
                        </div>

                        <div>
                            <label for="subject" class="block text-sm font-medium text-slate-700 mb-2">Subject</label>
                            <input type="text" id="subject" name="subject" required
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent outline-none transition"
                                placeholder="How can we help?">
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Message</label>
                            <textarea id="message" name="message" rows="5" required
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent outline-none transition resize-none"
                                placeholder="Tell us more about your inquiry..."></textarea>
                        </div>

                        <div class="flex flex-col gap-5">
                            <div style="display: none;">
                                <input id="captchaSiteKey" type="text" value="<%= captchaSiteKey %>" />
                            </div>
                            <button type="submit" id="contact-form-button" disabled 
                                class="w-1/2 mx-auto bg-amber-400 hover:bg-amber-500 text-white font-semibold py-3
                                rounded-lg transition duration-200 transform hover:scale-105 disabled:bg-amber-100 disabled:cursor-not-allowed cursor">
                                Send Message
                            </button>
                            <div id="recaptcha-container" class="mx-auto"></div>

                        </div>

                        <div id="form-message" class="hidden p-3 rounded-lg text-sm font-medium"></div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-300 px-18">
        <!-- Main Footer Content -->
        <div class="flex flex-col max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16 text-center">
            <div class="grid md:grid-cols-4 gap-8">
                <!-- About Section -->
                <div class="">
                    <div class="flex items-center justify-center gap-3 mb-4">
                        <img src="/public/f-assets/solid/drivers_ed_logo-no-bg.png" alt="DriversEd logo"
                            class="h-8 w-auto" />
                        <div>
                            <h3 class="text-white font-bold text-sm">Driver's Ed</h3>
                            <p class="text-xs text-slate-400">Driving School</p>
                        </div>
                    </div>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        We offer complete driving courses at affordable rates. Our skilled instructors deliver
                        competent, confident, and safe drivers.
                    </p>
                    <div class="flex justify-center gap-4 mt-4">
                        <a href="https://www.facebook.com/DriversEdDrivingSchool"
                            class="text-slate-400 hover:text-amber-400 transition">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333H16V2.169C15.547 2.118 14.303 2 12.479 2 9.412 2 7 3.655 7 6.699V8z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h4 class="text-white font-semibold mb-4">Quick Links</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#automate-slider-section" class="hover:text-amber-400 transition">Home</a></li>
                        <li><a href="#services-section" class="hover:text-amber-400 transition">Courses</a></li>
                        <li><a href="#instructor-section" class="hover:text-amber-400 transition">Instructors</a></li>
                        <li><a href="#branch-section" class="hover:text-amber-400 transition">Locations</a></li>
                        <li><a href="/public/contact-us" class="hover:text-amber-400 transition">Contact Us</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div>
                    <h4 class="text-white font-semibold mb-4">Get In Touch</h4>
                    <ul class="space-y-3 text-sm">
                        <li>
                            <p class="text-slate-400">Phone</p>
                            <p class="text-white font-medium">0917 326 4818</p>
                        </li>
                        <li>
                            <p class="text-slate-400">Email</p>
                            <p class="text-white font-medium">DriversEd1979@gmail.com</p>
                        </li>
                        <li>
                            <p class="text-slate-400">Hours</p>
                            <p class="text-white font-medium">Mon - Sat, 8:00 - 18:00</p>
                        </li>
                    </ul>
                </div>

                <!-- Enrollment Steps -->
                <div>
                    <h4 class="text-white font-semibold mb-4">Enroll Now</h4>
                    <ol class="text-sm space-y-2 list-decimal list-inside">
                        <li class="text-slate-400">Create Account</li>
                        <li class="text-slate-400">Choose Course</li>
                        <li class="text-slate-400">Pay Fee</li>
                        <li class="text-slate-400">Start Class</li>
                    </ol>
                    <a href="/account/user-login"
                        class="inline-block mt-4 px-4 py-2 bg-amber-400 hover:bg-amber-500 text-white rounded-md font-medium transition">
                        Enroll Now
                    </a>
                </div>
            </div>

            <!-- Divider -->
            <div
                class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-slate-400">
                <p>© <span id="year"></span> Driver's Ed Driving School. All rights reserved.</p>
                <div class="flex gap-6 mt-4 md:mt-0">
                    <a href="#" class="hover:text-amber-400 transition">Privacy Policy</a>
                    <a href="#" class="hover:text-amber-400 transition">Terms & Conditions</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="/public/f-jsfiles/contact-us.js" async defer></script>
    </script>
</body>

</html>
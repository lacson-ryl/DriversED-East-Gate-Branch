<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Manage Applicants</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <style>
        :root {
            --applicant-navy: #0B2D4A;
            --applicant-blue: #1976D2;
            --applicant-bg: #F4F7FB;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 0;
            background: var(--applicant-bg);
            color: #17324D;
            font-family: "Montserrat", "Segoe UI", sans-serif;
        }

        #main-content {
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }

        .applicant-card {
            border: 1px solid #E2E8F0;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 10px 30px rgba(11, 45, 74, .08);
        }

        .applicant-input {
            margin-top: .35rem;
            width: 100%;
            border: 1px solid #E2E8F0;
            border-radius: .6rem;
            background: #fff;
            padding: .65rem .75rem;
            font-size: .875rem;
            color: #17324D;
            outline: none;
        }

        .applicant-input:focus {
            border-color: #2585F5;
            box-shadow: 0 0 0 3px rgba(37, 133, 245, .12);
        }

        .applicant-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: .6rem;
            padding: .65rem .85rem;
            font-size: .8rem;
            font-weight: 700;
        }

        .applicant-action--primary {
            background: #1976D2;
            color: #fff;
        }

        .applicant-action--secondary {
            border: 1px solid #D8E2EC;
            background: #fff;
            color: #1976D2;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: .45rem;
            text-align: center;
        }

        .day {
            min-height: 6.5rem;
            border: 1px solid #E2E8F0;
            border-radius: .75rem;
            padding: .55rem;
            background: #fff;
            align-items: center;
        }

        .day.bg-red-50 {
            background: #F8FAFC;
            color: #94A3B8;
        }

        .day.bg-red-100 {
            background: #FFF7ED;
        }

        .day.bg-green-100 {
            border-color: #BBF7D0;
            background: #F0FDF4;
        }

        .day.bg-blue-200 {
            border-color: #BFDBFE;
            background: #EFF6FF;
        }

        .circle {
            width: 23px;
            height: 20px;
            padding: 0.5px;
            border-radius: 50%;
            text-align: center;
        }

        .available-am {
            background-color: #38a169;
            color: white;
        }

        .available-pm {
            background-color: #38a169;
            color: white;
        }

        .unavailable {
            color: transparent;
        }

        .onsite-tdc {
            background-color: #2563EB;
            color: white;
        }

        @media (max-width: 767px) {
            .day {
                min-height: 5.5rem;
                padding: .4rem;
            }

            .calendar {
                gap: .25rem;
            }
        }
    </style>
</head>

<body class="flex flex-row w-full">
    <div id="sidebar-container">
    </div>
    <main id="main-content" class="min-h-screen min-w-0 flex-1 md:ml-[220px]">
        <header id="top-bar"
            class="sticky top-0 flex min-h-[60px] items-center justify-between border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur md:px-8">
            <div id="left-side" class="flex items-center gap-4"><button id="notif-button"
                    class="relative rounded-xl p-2 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Open notifications"><img id="notif-logo" src="/account/f-assets/solid/bell.svg"
                        class="h-6 w-6" alt=""><span id="notif-new-indicator"
                        class="absolute right-1 top-1 hidden min-h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white"></span></button><img
                    id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png" class="h-8 w-auto"
                    alt="Driver's Ed"></div>
            <div id="right-side" class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[.18em] text-slate-400">Admin workspace</p>
                <h1 class="text-base font-bold text-[#0B2D4A] md:text-lg">Applicants</h1>
            </div>
        </header>

        <div id="content" class="mx-auto flex w-full max-w-[1500px] flex-col px-5 pb-12 pt-6 md:px-8">
            <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
                <div>
                    <p class="mb-1 text-xs font-semibold uppercase tracking-[.2em] text-[#1976D2]">Training operations
                    </p>
                    <h2 class="text-3xl font-bold tracking-tight text-[#0B2D4A]">Applicants</h2>
                    <p id="announcement" class="mt-1 text-sm text-slate-500">Schedule instructor training and review
                        availability.</p>
                </div>
                <a id="edit-profile-btn" href="/account/applicants-list"
                    class="applicant-action applicant-action--secondary" value="edit-profile-request">
                    Applicants List
                </a>
            </div>
            <div class="grid gap-5 lg:grid-cols-[minmax(280px,.75fr)_minmax(0,1.8fr)]">
                <div class="applicant-card p-5 md:p-6">
                    <form id="applicationForm">
                        <div class="mb-4">
                            <label for="instructoroption"
                                class="block text-xs font-semibold text-slate-600">Instructor</label>
                            <select id="instructor" name="instructor" required class="applicant-input">
                                <option value="">Select an Instructor</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="programoption"
                                class="block text-xs font-semibold text-slate-600">Program</label>
                            <select id="program" name="program" required class="applicant-input">
                                <option value="">Select a program</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="startDate" class="block text-xs font-semibold text-slate-600">Starting date
                                (first
                                half)</label>
                            <input type="date" id="startDate" name="startDate" required
                                class="date-input applicant-input">
                            <select id="startDateAMPM" name="startDateAMPM" required class="applicant-input">
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="continuation" class="block text-xs font-semibold text-slate-600">Continuation
                                (second half)</label>
                            <input type="date" id="continuation" name="continuation" required
                                class="date-input applicant-input">
                            <select id="continuationAMPM" name="continuationAMPM" required class="applicant-input">
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="transmission"
                                class="block text-xs font-semibold text-slate-600">Transmission</label>
                            <select id="transmission" name="transmission" required class="applicant-input">
                                <option value="manual">Manual</option>
                                <option value="automatic">Automatic</option>
                            </select>
                        </div>
                        <div class="flex flex-row items-center justify-between gap-3 pt-2">
                            <button type="submit" class="applicant-action applicant-action--primary">Submit</button>
                            <div class="flex flex-col gap-2">
                                <a id="setTdcDate"
                                    class="applicant-action applicant-action--secondary hover:cursor-pointer">
                                    Set Date for TDC
                                </a>
                                <a id="add-continuation"
                                    class="applicant-action applicant-action--secondary hover:cursor-pointer">
                                    add Continuation
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
                <!-- Calendar -->
                <div class="applicant-card p-5 md:p-6">
                    <div id="color-stamps-instructions"
                        class="mb-5 flex flex-wrap gap-3 border-b border-slate-100 pb-4 text-xs text-slate-500">
                        <div class="flex flex-row gap-3">
                            <div class="circle available-am place-self-center">AM</div>
                            <div class="circle available-pm place-self-center">PM</div>
                            <p>- PDC slots taken</p>
                        </div>
                        <div class="flex flex-row gap-3">
                            <div class="circle onsite-tdc place-self-center">25</div>
                            <p>- TDC slots availability</p>
                        </div>
                        <div class="flex flex-row gap-3">
                            <div class="bg-green-100 w-6 h-6 place-self-center"></div>
                            <p>- no slots taken</p>
                        </div>
                    </div>

                    <div class="mb-4 flex items-center justify-between">
                        <button id="prevMonth" class="applicant-action applicant-action--secondary">Previous</button>
                        <div id="monthLabel" class="text-base font-bold text-[#0B2D4A]"></div>
                        <button id="nextMonth" class="applicant-action applicant-action--secondary">Next</button>
                    </div>
                    <div class="grid grid-cols-7 mt-4 text-center">
                        <div class="pl-1 text-sm">Mon</div>
                        <div class="pl-1 text-sm">Tue</div>
                        <div class="pl-1 text-sm">Wed</div>
                        <div class="pl-1 text-sm">Thu</div>
                        <div class="pl-1 text-sm">Fri</div>
                        <div class="pl-1 text-sm">Sat</div>
                        <div class="pl-1 text-sm">Sun</div>
                    </div>
                    <div id="calendar" class="calendar mt-1">
                    </div>
                </div>
            </div>

            <div id="myModal" class="fixed inset-0 z-50 items-center justify-center hidden bg-gray-900 bg-opacity-50">
                <div class="relative bg-white rounded-lg shadow-lg min-w-screen-md max-w-screen-md p-6">
                    <span
                        class="close absolute top-0 right-2 text-3xl font-semibold text-gray-700 hover:text-gray-900 cursor-pointer ">&times;</span>
                    <h2 id="modal-title" class="text-xl font-semibold">Payment Method Details</h2>
                    <p id="modal-details" class="mt-4">the details</p>
                </div>
            </div>
        </div>

        </div>
        </div>
        <script type="module" src="/account/utils/modal-feedback.js"></script>
        <script>

            document.addEventListener('DOMContentLoaded', async () => {
                try {
                    const sidebarScript = document.createElement('script');
                    sidebarScript.src = '/account/f-jsfiles/sidebar.js';
                    document.body.appendChild(sidebarScript);

                    const schedulerScript = document.createElement('script');
                    schedulerScript.src = '/account/f-jsfiles/applicant-schedule.js';
                    schedulerScript.type = 'module';
                    document.body.appendChild(schedulerScript);
                } catch (error) {
                    console.error('Authorization error:', error);
                    alert("You are not authorized to view this page.");
                    window.location.href = '/account/adminlogin'; // Redirect to login if not authorized
                }
            });

        </script>
</body>

</html>
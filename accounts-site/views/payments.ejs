<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-auto overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Manage Payments</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <style>
        :root {
            --payments-navy: #0B2D4A;
            --payments-blue: #1976D2;
            --payments-bg: #F4F7FB;
        }

        body {
            min-width: 0;
            background: var(--payments-bg);
            font-family: "Montserrat", "Segoe UI", sans-serif;
        }

        #main-content {
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }

        .payments-table-frame {
            max-height: min(68vh, 46rem);
            overflow: auto;
            border: 1px solid #E2E8F0;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 10px 30px rgba(11, 45, 74, .08);
        }

        .payments-table-frame table {
            min-width: 980px;
        }

        .payments-table-frame th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: #F8FAFC;
            color: #64748B;
            font-size: .7rem;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .payments-table-frame td {
            white-space: nowrap;
        }

        .payments-action {
            display: inline-flex;
            min-height: 2rem;
            align-items: center;
            justify-content: center;
            border-radius: .5rem;
            padding: .35rem .6rem;
            font-size: .75rem;
            font-weight: 700;
            transition: background-color .2s ease, color .2s ease;
        }

        .payments-action--view {
            background: #EFF6FF;
            color: #1D4ED8;
        }

        .payments-action--view:hover {
            background: #93C5FD;
            /* darker blue */
        }

        .payments-action--upload {
            background: #FFFBEB;
            color: #B45309;
        }

        .payments-action--upload:hover {
            background: #F59E0B;
            /* darker amber */
        }

        .payments-action--status {
            border: 1px solid #CBD5E1;
            background: #F8FAFC;
            color: #334155;
        }

        .payments-action--status:hover {
            background: #94A3B8;
            /* darker slate gray */
        }

        .payments-action--delete {
            background: #FFF1F2;
            color: #BE123C;
        }

        .payments-action--delete:hover {
            background: #DC2626;
            /* darker red */
        }

        /* Smooth transition for hover effect */
        .payments-action--view,
        .payments-action--upload,
        .payments-action--status,
        .payments-action--delete {
            transition: background-color 0.25s ease-in-out;
        }
    </style>
    <script type="module">
        import Dexie from "https://cdn.jsdelivr.net/npm/dexie@3.2.4/dist/dexie.mjs";
        window.Dexie = Dexie;
    </script>
</head>

<body class="flex flex-row w-full over">
    <div id="sidebar-container">
    </div>
    <div id="main-content" class="block ml-ml-250 w-calc animate-fadeIn space-y-2">
        <div id="top-bar"
            class="sticky top-0 z-30 flex min-h-[60px] items-center justify-between border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur "md:px-8>
            <div id="left-side" class="flex items-center gap-4">
                <button id="notif-button"
                    class="relative rounded-xl p-2 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Open notifications">
                    <img id="notif-logo" src="/account/f-assets/solid/bell.svg" class="h-6 w-6" alt="">
                    <span id="notif-new-indicator"
                        class="absolute right-1 top-1 hidden min-h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white"></span>
                </button>
                <img id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png"
                    class="h-8 w-auto object-contain" alt="Driver's Ed">
            </div>
            <div id="right-side" class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[.18em] text-slate-400">Admin workspace</p>
                <h1 class="text-base font-bold text-[#0B2D4A] md:text-lg">Manage Payments</h1>
            </div>
        </div>

        <div id="content" class="flex flex-col w-full">
            <div class="flex flex-col justify-between gap-4 px-5 pb-2 pt-6 md:flex-row md:items-end md:px-8">
                <div>
                    <p class="mb-1 text-xs font-semibold uppercase tracking-[.2em] text-[#1976D2]">Payment operations
                    </p>
                    <h2 class="text-3xl font-bold tracking-tight text-[#0B2D4A]">Applicant payments</h2>
                    <p class="mt-1 text-sm text-slate-500">Review, verify, and manage applicant payment records.</p>
                </div>
                <div id="notification" class="hidden notification"></div>
                <div class="flex flex-wrap items-center gap-2">
                    <form id="monthyearfilter">
                        <div
                            class="flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-white p-2 shadow-sm">
                            <label for="monthyear"
                                class="text-xs font-bold uppercase tracking-wide text-slate-500">Month</label>
                            <input type="month" id="monthyear" name="monthyear" min="1976-03"
                                class="h-9 rounded-lg border border-slate-200 bg-white px-2 text-sm" />
                            <button type="submit"
                                class="rounded-lg bg-[#0B2D4A] px-3 py-2 text-xs font-bold text-white hover:bg-[#1976D2]">Filter</button>
                        </div>
                    </form>
                    <button id="add-payment-button"
                        class="flex items-center gap-1 rounded-lg bg-[#1976D2] px-3 py-2 text-sm font-bold text-white hover:bg-[#0B2D4A]">
                        <IMG src="/account/f-assets/solid/white/plus.svg" class="w-7 h-7" />
                        <span class="inline-block">Add Payment</span>
                    </button>
                </div>
            </div>

            <div id="payments-table" class="payments-table-frame mx-5 mb-8 mt-4 md:mx-8">

            </div>
        </div>
    </div>
    <script type="module" src="/account/utils/f-webCryptoKeys.js"></script>
    <script type="module" src="/account/utils/f-keyManager.js"></script>
    <script type="module" src="/account/utils/modal-feedback.js"></script>

    <script>

        document.addEventListener('DOMContentLoaded', async () => {
            console.log('Page loaded, checking admin dashboard access');

            try {
                const sidebarScript = document.createElement('script');
                sidebarScript.src = '/account/f-jsfiles/sidebar.js';
                document.body.appendChild(sidebarScript);

                const addPaymentScript = document.createElement('script');
                addPaymentScript.src = '/account/f-jsfiles/payments.js';
                addPaymentScript.type = "module";
                document.body.appendChild(addPaymentScript);
            } catch (error) {
                console.error('Authorization error:', error);
                alert("You are not authorized to view this page.");
                window.location.href = '/account/adminlogin'; // Redirect to login if not authorized
            }
        });

    </script>
</body>

</html>
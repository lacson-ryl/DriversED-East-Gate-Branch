<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Manage People</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <style>
        :root {
            --people-navy: #0B2D4A;
            --people-blue: #1976D2;
            --people-bg: #F4F7FB;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 0;
            background: var(--people-bg);
            color: #17324D;
            font-family: "Montserrat", "Segoe UI", sans-serif;
        }

        #main-content {
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }

        .people-card {
            border: 1px solid #E2E8F0;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 10px 30px rgba(11, 45, 74, .08);
        }

        .people-table-frame {
            max-height: min(62vh, 42rem);
            overflow: auto;
            border: 1px solid #E2E8F0;
            border-radius: .85rem;
            background: #fff;
        }

        .people-table-frame th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: #F8FAFC;
            color: #64748B;
            font-size: .7rem;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .people-table-frame td {
            white-space: nowrap;
        }

        #myModal>div {
            width: min(100%, 52rem);
            max-height: min(90vh, 52rem);
            overflow-y: auto;
        }

        #modal-details form {
            width: 100%;
            max-width: 46rem;
            margin-inline: auto;
        }

        #modal-details input,
        #modal-details select {
            min-width: 0;
        }

        @media (max-width: 767px) {
            #main-content {
                margin-left: 0;
            }

            .people-table-frame {
                max-height: 55vh;
            }

            .people-table-frame table {
                min-width: 1100px;
            }
        }
    </style>
    <script type="module">
        import Dexie from "https://cdn.jsdelivr.net/npm/dexie@3.2.4/dist/dexie.mjs";
        window.Dexie = Dexie;
    </script>
</head>

<body class="flex min-h-screen w-full flex-row">
    <div id="sidebar-container" class="z-50"></div>
    <div id="main-content" class="min-h-screen min-w-0 flex-1 md:ml-[220px]">
        <header id="top-bar"
            class="sticky top-0 z-30 flex min-h-[60px] items-center justify-between border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur md:px-8">
            <div id="left-side" class="flex items-center gap-4">
                <button id="notif-button"
                    class="relative rounded-xl p-2 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Open notifications">
                    <img id="notif-logo" src="/account/f-assets/solid/bell.svg" class="h-6 w-6" alt="">
                    <span id="notif-new-indicator"
                        class="absolute right-1 top-1 hidden min-h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white"></span>
                </button>
                <img id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png"
                    class="h-8 w-auto object-contain" alt="Driver's Ed">
            </div>
            <div id="right-side" class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[.18em] text-slate-400">Admin workspace</p>
                <h1 class="text-base font-bold text-[#0B2D4A] md:text-lg">Manage People</h1>
            </div>
        </header>

        <div id="content" class="mx-auto flex w-full flex-col px-5 pb-6 pt-6">
            <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
                <div>
                    <p class="mb-1 text-xs font-semibold uppercase tracking-[.2em] text-[#1976D2]">People and payroll
                    </p>
                    <h2 class="text-3xl font-bold tracking-tight text-[#0B2D4A]">Manage People</h2>
                    <p class="mt-1 text-sm text-slate-500">Manage instructors, accounts, benefits, and payroll history.
                    </p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button id="audit-report-button"
                        class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-[#0B2D4A] hover:border-[#1976D2]">
                        <span class="inline-block">Audit Report</span>
                    </button>
                    <button id="show-accounts-button"
                        class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-[#0B2D4A] hover:border-[#1976D2]">
                        <span class="inline-block">Show Accounts</span>
                    </button>
                    <button id="add-instructor-button"
                        class="flex items-center gap-1 rounded-lg bg-[#1976D2] px-3 py-2 text-sm font-bold text-white hover:bg-[#0B2D4A]">
                        <IMG src="/account/f-assets/solid/white/plus.svg" class="w-7 h-7" />
                        <span class="inline-block">Add Instructor</span>
                    </button>
                </div>
            </div>
            <div id="instructors-table" class="people-card people-table-frame mb-6 animate-fadeIn">

            </div>
            <div id="accounts-table" class="people-card people-table-frame mb-6 hidden animate-fadeIn">

            </div>
            <div class="mb-4 flex w-full flex-wrap items-center justify-end gap-3">
                <button id="back-button"
                    class="hidden rounded-lg bg-[#1976D2] px-3 py-2 text-sm font-bold text-white hover:bg-[#0B2D4A]">
                    Back
                </button>
                <div id="year-filter"
                    class="hidden items-center gap-4 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm">
                    <h2 class="text-sm font-bold text-[#0B2D4A]">Payroll history</h2>
                    <div id="year-month-payroll-filter-form" class="gap-5">
                        <form id="year-month-payroll-filter-form">
                            <select id="month" name="month"
                                class="rounded-lg border border-slate-200 bg-white p-2 text-sm">
                                <option value="" selected>Select month</option>
                                <option value="January">January</option>
                                <option value="February">February</option>
                                <option value="March">March</option>
                                <option value="April">April</option>
                                <option value="May">May</option>
                                <option value="June">June</option>
                                <option value="July">July</option>
                                <option value="August">August</option>
                                <option value="September">September</option>
                                <option value="October">October</option>
                                <option value="November">November</option>
                                <option value="December">December</option>
                            </select>
                            <input type="number" id="year" name="year" placeholder="Input year"
                                class="h-9 rounded-lg border border-slate-200 bg-white pl-3 text-sm focus:outline-none">
                            <button type="submit"
                                class="rounded-lg bg-[#1976D2] px-3 py-2 text-sm font-bold text-white hover:bg-[#0B2D4A]">
                                Filter
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div id="instructors-current-payroll-table" style="display: none;"
            class="people-card people-table-frame mb-6 p-4 flex flex-col w-full">

        </div>


    </div>
    </div>

    <div id="myModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
        <div class="relative w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl bg-white p-5 shadow-xl md:p-6">
            <span
                class="close absolute top-0 right-2 text-3xl font-semibold text-gray-700 hover:text-gray-900 cursor-pointer ">&times;</span>
            <h2 id="modal-title" class="text-xl font-semibold">Instructor Details</h2>
            <div id="modal-details" class="mt-4"></div>
        </div>
    </div>
    <script type="module" src="/account/utils/f-webCryptoKeys.js"></script>
    <script type="module" src="/account/utils/f-keyManager.js"></script>
    <script type="module" src="/account/utils/modal-feedback.js"></script>
    <script>

        document.addEventListener('DOMContentLoaded', async () => {
            console.log('Page loaded, checking admin dashboard access');

            try {
                const sidebarScript = document.createElement('script');
                sidebarScript.src = '/account/f-jsfiles/sidebar.js';
                document.body.appendChild(sidebarScript);

                const managePeopleScript = document.createElement('script');
                managePeopleScript.src = '/account/f-jsfiles/manage-people.js';
                managePeopleScript.type = "module";
                document.body.appendChild(managePeopleScript);

            } catch (error) {
                console.error('Authorization error:', error);
                alert("You are not authorized to view this page.");
                window.location.href = '/account/adminlogin'; // Redirect to login if not authorized
            }
        });

    </script>
</body>


</html>
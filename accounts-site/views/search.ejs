<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-auto overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search User</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <script type="module">
        import Dexie from "https://cdn.jsdelivr.net/npm/dexie@3.2.4/dist/dexie.mjs";
        window.Dexie = Dexie;
    </script>
</head>

<body class="flex flex-row w-full over">
    <div id="sidebar-container">
    </div>
    <div id="main-content" class="block ml-ml-250 w-calc animate-fadeIn">
        <div id="top-bar" class="flex h-15 flex-row w-full sticky shadow-inner bg-white border-b-2 p-4">
            <div id="left-side" class="flex flex-row gap-4 relative">
                <div>
                    <button id="notif-button" class="relative">
                        <img id="notif-logo" src="/account/f-assets/solid/bell.svg" class="w-7 h-7 inline-block" />
                        <div id="notif-new-indicator"
                            class="h-3 w-3 rounded-full bg-blue-900 absolute top-2 right-2 transform translate-x-1/2 -translate-y-1/2 animate-pulse hidden">
                        </div>
                    </button>
                </div>
                <img id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png" class="w-20 h-8" />
            </div>
            <div id="right-side" class="absolute right-4 text-lg">
                Search User
            </div>
        </div>

        <div id="content" class="flex flex-col w-full">
            <div class="mr-4 my-4">
                <form id="search-form" class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5">

                    <!-- Header -->
                    <div class="flex items-center justify-between mb-4">

                        <div>
                            <h2 class="text-lg font-semibold text-gray-800">
                                Search User
                            </h2>

                            <p class="text-xs text-gray-500 mt-1">
                                Find a user by ID, email, name, or PRN.
                            </p>
                        </div>

                        <div class="hidden sm:flex items-center gap-2 text-xs text-gray-400">
                            <span class="w-2 h-2 rounded-full bg-green-500"></span>

                            User Search
                        </div>

                    </div>


                    <!-- Search Controls -->
                    <div class="flex flex-col lg:flex-row gap-3">

                        <!-- Search Option -->
                        <div class="relative lg:w-52">

                            <label for="search-option" class="block text-xs font-medium text-gray-600 mb-1.5">
                                Search by
                            </label>

                            <select name="searchOption" id="search-option" class="w-full h-10 px-3 pr-8
                           bg-gray-50
                           border border-gray-200
                           rounded-xl
                           text-sm text-gray-700
                           focus:outline-none
                           focus:ring-2
                           focus:ring-blue-500/20
                           focus:border-blue-500
                           transition">
                                <option value="">
                                    Select option
                                </option>

                                <option value="user-id">
                                    User ID
                                </option>

                                <option value="user-email">
                                    User Email
                                </option>

                                <option value="user-name">
                                    User Name
                                </option>

                                <option value="user-prn">
                                    User PRN
                                </option>
                            </select>

                        </div>


                        <!-- Search Input -->
                        <div class="flex-1">

                            <label for="input-user-info" class="block text-xs font-medium text-gray-600 mb-1.5">
                                Search value
                            </label>

                            <div class="relative">

                                <!-- Search Icon -->
                                <svg class="absolute left-3 top-1/2 -translate-y-1/2
                               w-4 h-4 text-gray-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg"
                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
                                </svg>

                                <input type="text" id="input-user-info" name="userInfo"
                                    placeholder="Enter user information..." required class="w-full h-10
                               pl-10 pr-4
                               bg-gray-50
                               border border-gray-200
                               rounded-xl
                               text-sm text-gray-700
                               placeholder:text-gray-400
                               focus:outline-none
                               focus:ring-2
                               focus:ring-blue-500/20
                               focus:border-blue-500
                               transition" />

                            </div>

                        </div>


                        <!-- Search Button -->
                        <div class="lg:self-end">

                            <button type="submit" class="w-full lg:w-auto
                           h-10
                           px-6
                           inline-flex
                           items-center
                           justify-center
                           gap-2
                           bg-blue-600
                           hover:bg-blue-700
                           active:bg-blue-800
                           text-white
                           text-sm
                           font-medium
                           rounded-xl
                           shadow-sm
                           hover:shadow
                           transition-all
                           duration-150">

                                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
                                </svg>

                                Search

                            </button>

                        </div>

                    </div>

                </form>
            </div>

            <div id="user-infos" class="mt-3 mb-5 mx-3 grid grid-cols-3  animate-fadeIn">

            </div>
            <div id="selected-user-info-container" style="display: none;" class="mt-3 mb-5 mx-3  animate-fadeIn">

            </div>



        </div>
    </div>
    <div id="myModal" class="fixed -inset-0 z-50 items-center justify-center hidden bg-gray-900 bg-opacity-50">
        <div class="relative bg-white rounded-lg shadow-lg min-w-screen-lg max-w-screen-lg p-6 ">
            <span
                class="close absolute top-0 right-2 text-3xl font-semibold text-gray-700 hover:text-gray-900 cursor-pointer ">&times;</span>
            <h2 id="title-details" class="text-xl font-semibold"></h2>
            <p id="modal-details" class="mt-4">the details</p>
        </div>
    </div>
    <script type="module" src="/account/utils/f-webCryptoKeys.js"></script>
    <script type="module" src="/account/utils/f-keyManager.js"></script>
    <script type="module" src="/account/utils/modal-feedback.js"></script>
    <script type="module" src="/account/utils/file-helper.js"></script>

    <script>

        document.addEventListener('DOMContentLoaded', async () => {
            console.log('Page loaded');

            try {
                const sidebarScript = document.createElement('script');
                sidebarScript.src = '/account/f-jsfiles/sidebar.js';
                document.body.appendChild(sidebarScript);

                const searchScript = document.createElement('script');
                searchScript.src = '/account/f-jsfiles/search.js';
                searchScript.type = 'module';
                document.body.appendChild(searchScript);
            } catch (error) {
                console.error('Authorization error:', error);
                alert("You are not authorized to view this page.");
                window.location.href = '/account/adminlogin'; // Redirect to login if not authorized
            }
        });

    </script>
</body>

</html>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile | Driver's Ed</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <script type="module">
        import Dexie from "https://cdn.jsdelivr.net/npm/dexie@3.2.4/dist/dexie.mjs";
        window.Dexie = Dexie;
    </script>
    <style>
        :root {
            --profile-navy: #0B2D4A;
            --profile-blue: #1976D2;
            --profile-bg: #F4F7FB;
        }

        body {
            min-width: 0;
            background: var(--profile-bg);
            font-family: "Montserrat", "Segoe UI", sans-serif;
        }

        #main-content {
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }

        /* Custom bounce that runs once for 5s */
        @keyframes bounce-once {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-10px);
            }

            60% {
                transform: translateY(-5px);
            }
        }

        .bounce-once {
            animation: bounce-once 5s ease;
        }

        /* Desktop hover behavior */
        @media (hover: hover) {
            #lock-info:hover+#lock-tooltip {
                display: block;
            }
        }
    </style>
</head>

<body class="flex min-h-screen w-full flex-row">
    <div id="sidebar-container">
    </div>
    <div id="main-content" class="min-h-screen min-w-0 flex-1 md:ml-[180px] animate-fadeIn">
        <div id="top-bar"
            class="sticky top-0 z-30 flex min-h-[60px] items-center justify-between border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur">
            <div id="left-side" class="flex items-center gap-4">
                <button id="notif-button"
                    class="relative rounded-xl p-2 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Open notifications">
                    <img id="notif-logo" src="/account/f-assets/solid/bell.svg" class="h-6 w-6" alt="" />
                    <span id="notif-new-indicator"
                        class="absolute right-1 top-1 hidden min-h-4 min-w-4 -translate-y-1/2 translate-x-1/2 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white shadow-sm"
                        aria-live="polite"></span>
                </button>
                <img id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png"
                    class="h-8 w-auto object-contain" alt="Driver's Ed Driving School" />
            </div>
            <div id="right-side" class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Client portal</p>
                <h1 class="text-base font-bold text-[#0B2D4A] md:text-lg">Profile</h1>
            </div>
        </div>

        <div id="content" class="flex flex-col w-full items-center">
            <div id="profile-display" class="w-full flex justify-center">

            </div>
        </div>
        <script type="module" src="/account/utils/f-webCryptoKeys.js"></script>
        <script type="module" src="/account/utils/f-keyManager.js"></script>

        <script>

            document.addEventListener('DOMContentLoaded', async () => {
                try {
                    const script = document.createElement('script');
                    script.src = '/account/f-jsfiles/user-sidebar.js';
                    document.body.appendChild(script);

                    const profileScript = document.createElement('script');
                    profileScript.src = '/account/f-jsfiles/user-profile.js';
                    profileScript.type = "module";
                    document.body.appendChild(profileScript);

                } catch (error) {
                    console.error('Authorization error:', error);
                    alert("You are not authorized to view this page.");
                    window.location.href = '/account/user-login'; // Redirect to login if not authorized
                }
            });



        </script>
        <div id="notificationDropdown"
            class="hidden absolute w-72 max-h-80 overflow-auto bg-white shadow-lg rounded border border-black"
            style="z-index: 99999;">
            <div class="p-2">
                <h3 class="font-semibold">Recent Notifications</h3>
                <ul id="notificationList" class="text-sm"></ul>
            </div>
        </div>
</body>

</html>
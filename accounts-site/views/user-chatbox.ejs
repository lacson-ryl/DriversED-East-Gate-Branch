<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Support Chat</title>
  <link href="/account/f-css/output.css" rel="stylesheet">
</head>
<body data-role="user" class="flex min-h-screen bg-slate-100">
  <div id="sidebar-container"></div>
  <main class="ml-16 flex min-h-screen max-h-screen flex-1 flex-col md:ml-[160px]">
    <header class="relative flex items-center justify-between border-b bg-white p-4 shadow-sm">
      <h1 class="text-lg font-semibold text-slate-800">Support Chat</h1>
      <button id="new-ticket-btn" class="rounded bg-sky-900 px-4 py-2 font-semibold text-white hover:bg-sky-700">New Ticket</button>
    </header>
    <section class="flex min-h-0 flex-1 flex-col gap-4 p-4 md:flex-row">
      <aside class="flex w-full flex-col rounded-lg bg-white shadow md:w-1/2">
        <h2 class="border-b p-4 font-semibold">Ticket History</h2>
        <div id="ticket-list" class="min-h-32 flex-1 overflow-y-auto"></div>
      </aside>
      <section class="flex min-h-[28rem] min-w-0 flex-1 flex-col rounded-lg bg-white shadow">
        <div id="thread-header" class="border-b p-4 font-semibold text-slate-700">Select a ticket</div>
        <div id="message-list" class="min-h-0 flex-1 overflow-y-auto"></div>
        <form id="message-form" class="flex gap-2 border-t p-3">
          <input id="message-input" class="min-w-0 flex-1 rounded border px-3 py-2" placeholder="Write a message..." disabled required>
          <button class="rounded bg-sky-900 px-4 py-2 font-semibold text-white disabled:opacity-50" disabled>Send</button>
        </form>
      </section>
    </section>
  </main>
  <div id="ticket-modal" class="absolute right-4 top-20 z-50 hidden w-full max-w-sm">
    <form id="ticket-form" class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">
      <div class="mb-4 flex justify-between"><h2 class="text-xl font-semibold">New Ticket</h2><button type="button" id="close-ticket-modal" class="text-2xl">&times;</button></div>
      <input id="ticket-title" class="mb-3 w-full rounded border px-3 py-2" placeholder="Title" required>
      <select id="ticket-type" class="mb-3 w-full rounded border px-3 py-2" required><option value="report">Report</option><option value="request">Request</option><option value="inquiry">Inquiry</option></select>
      <textarea id="ticket-message" class="mb-4 min-h-32 w-full rounded border px-3 py-2" placeholder="Describe your concern..." required></textarea>
      <button class="rounded bg-sky-900 px-4 py-2 font-semibold text-white">Create Ticket</button>
      <p id="ticket-error" class="mt-2 text-sm text-red-600"></p>
    </form>
  </div>
  <script src="/account/f-jsfiles/user-sidebar.js"></script>
  <script type="module" src="/account/f-jsfiles/user-chatbox.js"></script>
</body>
</html>
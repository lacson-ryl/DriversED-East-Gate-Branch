<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-auto overflow-y-auto">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Manage Programs</title>
    <link href="/account/f-css/output.css" rel="stylesheet">
    <style>
        :root {
            --programs-bg: #F4F7FB;
        }

        body {
            min-width: 0;
            background: var(--programs-bg);
            font-family: "Montserrat", "Segoe UI", sans-serif;
        }

        #main-content {
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }

        .programs-table-frame {
            max-height: min(70vh, 48rem);
            overflow: auto;
            border: 1px solid #E2E8F0;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 10px 30px rgba(11, 45, 74, .08);
        }

        .programs-table-frame table {
            min-width: 1180px;
        }

        .programs-table-frame th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: #F8FAFC;
            color: #64748B;
            font-size: .7rem;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .programs-table-frame td {
            white-space: nowrap;
        }

        .program-action {
            display: inline-flex;
            min-height: 2rem;
            min-width: 2rem;
            align-items: center;
            justify-content: center;
            border-radius: .5rem;
            padding: .35rem .6rem;
            font-size: .75rem;
            font-weight: 700;
            transition: background-color .2s ease, color .2s ease;
        }

        .program-action--primary {
            background: #EFF6FF;
            color: #1D4ED8;
        }

        .program-action--primary:hover {
            background: #BFDBFE;
            /* deeper blue shade */
        }

        .program-action--warning {
            background: #FFFBEB;
            color: #B45309;
        }

        .program-action--warning:hover {
            background: #FCD34D;
            /* darker golden tone */
        }

        .program-action--danger {
            background: #FFF1F2;
            color: #BE123C;
        }

        .program-action--danger:hover {
            background: #FCA5A5;
            /* deeper red-pink */
        }

        .program-action--neutral {
            background: #F1F5F9;
            color: #334155;
        }

        .program-action--neutral:hover {
            background: #CBD5E1;
            /* darker gray-blue */
        }

        /* Smooth transition for hover effect */
        .program-action--primary,
        .program-action--warning,
        .program-action--danger,
        .program-action--neutral {
            transition: background-color 0.25s ease-in-out;
        }
    </style>

</head>

<body class="flex flex-row w-full over">
    <div id="sidebar-container">
    </div>
    <div id="main-content" class="block ml-ml-250 w-calc animate-fadeIn space-y-2">
        <div id="top-bar"
            class="sticky top-0 z-30 flex min-h-[60px] items-center justify-between border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur md:px-8">
            <div id="left-side" class="flex items-center gap-4">
                <button id="notif-button"
                    class="relative rounded-xl p-2 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Open notifications">
                    <img id="notif-logo" src="/account/f-assets/solid/bell.svg" class="h-6 w-6" alt="">
                    <span id="notif-new-indicator"
                        class="absolute right-1 top-1 hidden min-h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white"></span>
                </button>
                <img id="company-logo" src="/account/f-assets/solid/drivers_ed_logo-no-bg.png"
                    class="h-8 w-auto object-contain" alt="Driver's Ed">
            </div>
            <div id="right-side" class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[.18em] text-slate-400">Admin workspace</p>
                <h1 class="text-base font-bold text-[#0B2D4A] md:text-lg">Manage Programs</h1>
            </div>
        </div>

        <div id="content" class="flex flex-col w-full">
            <div class="flex flex-col justify-between gap-4 px-5 pb-2 pt-6 md:flex-row md:items-end">
                <div>
                    <p class="mb-1 text-xs font-semibold uppercase tracking-[.2em] text-[#1976D2]">Training catalog</p>
                    <h2 class="text-3xl font-bold tracking-tight text-[#0B2D4A]">Manage Programs</h2>
                    <p class="mt-1 text-sm text-slate-500">Maintain programs and instructor assignments.</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button id="add-program-button"
                        class="flex items-center gap-1 rounded-lg bg-[#1976D2] px-3 py-2 text-sm font-bold text-white hover:bg-[#0B2D4A]">
                        <IMG src="/account/f-assets/solid/white/plus.svg" class="w-7 h-7" />
                        <span class="inline-block">Add Program</span>
                    </button>

                    <button id="assign-programs-instructor-button"
                        class="flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-[#0B2D4A] hover:border-[#1976D2]">
                        <IMG src="/account/f-assets/solid/white/plus.svg" class="w-7 h-7 reverse-color" />
                        <span class="inline-block">Assign Programs - Instructor</span>
                    </button>
                </div>
            </div>
            <div id="programs-table" class="programs-table-frame mx-5 mb-8 mt-4">

            </div>


        </div>
    </div>

    <div id="myModal" class="fixed inset-0 z-50 items-center justify-center hidden bg-gray-900 bg-opacity-50">
        <div class="relative bg-white rounded-lg shadow-lg min-w-96 max-w-screen-md p-6">
            <span
                class="close absolute top-0 right-2 text-3xl font-semibold text-gray-700 hover:text-gray-900 cursor-pointer ">&times;</span>
            <h2 class="text-xl font-semibold">Program Details</h2>
            <p id="modal-details" class="mt-4">the details</p>
        </div>
    </div>
    <script type="module" src="/account/utils/modal-feedback.js"></script>
    <script>

        document.addEventListener('DOMContentLoaded', async () => {
            console.log('Page loaded, checking admin dashboard access');

            try {
                const sidebarScript = document.createElement('script');
                sidebarScript.src = '/account/f-jsfiles/sidebar.js';
                document.body.appendChild(sidebarScript);

                const addFormScript = document.createElement('script');
                addFormScript.src = '/account/f-jsfiles/program.js';
                addFormScript.type = 'module';
                document.body.appendChild(addFormScript);

            } catch (error) {
                console.error('Authorization error:', error);
                alert("You are not authorized to view this page.");
                window.location.href = '/adminlogin'; // Redirect to login if not authorized
            }
        });

    </script>
</body>

</html>